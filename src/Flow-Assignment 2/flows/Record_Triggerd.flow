            </value>
        </inputAssignments>
        <inputAssignments>
            <name>varB_afterUpdate</name>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>varR_newContactRecord</name>
            <value>
                <elementReference>$Record</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>varR_oldContactRecord</name>
            <value>
                <elementReference>$Record__Prior</elementReference>
            </value>
        </inputAssignments>
    </subflows>
    <subflows>
        <name>Subflow_Contact_Handler_1</name>
        <label>Subflow : Contact Handler</label>
        <locationX>314</locationX>
        <locationY>431</locationY>
